<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Ternary-teal.ico</ApplicationIcon>
    <PackageIcon>Ternary-teal.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove=".env" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Ternary-teal.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="HyRest" />
    <PackageReference Include="HyRest.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.ImageSharp" />
    <PackageReference Include="Ternary.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\resources\Ternary-teal.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include=".env">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Spectre.Console" />
    <Using Include="Ternary.Extensions.Logging" />
    <Using Include="HyRest" />
  </ItemGroup>

</Project>
